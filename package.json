{
  "name": "claude-cron-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/cron.ts",
    "watch": "bun --watch src/cron.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "fmt": "biome format --write src",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.266",
    "croner": "10.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  }
}
