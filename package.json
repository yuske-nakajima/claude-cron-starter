{
  "name": "claude-cron-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/cron.ts",
    "watch": "bun --watch src/cron.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "fmt": "biome format --write src",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "croner": "11.0.0"
  },
  "overrides": {
    "@hono/node-server": ">=2.1.3",
    "hono": ">=4.13.11",
    "body-parser": ">=2.4.0",
    "fast-uri": ">=3.1.9",
    "ip-address": ">=10.7.4",
    "proxy-addr": ">=2.0.8",
    "qs": ">=6.16.1",
    "zod": ">=4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
